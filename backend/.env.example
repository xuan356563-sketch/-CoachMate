# 仅用于本地 Docker 开发。不得提交真实短信或 DeepSeek 密钥。
APP_ENV=development
APP_VERSION=development
DATABASE_URL=postgresql+psycopg://trainflow:trainflow@postgres:5432/trainflow
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:3980,http://localhost:8000,http://localhost:8083,http://127.0.0.1:8083
# 云同步默认关闭；运营接口只允许由独立进程绑定私网或 127.0.0.1。
SYNC_ENABLED=false
SYNC_BATCH_LIMIT=100
HEALTH_PROFILE_CLOUD_ENABLED=false
HEALTH_PROFILE_CONSENT_VERSION=health-profile-cloud-2026-07-31.1
# 生产环境必须使用密钥管理服务注入 Base64 编码的32字节密钥。
PROFILE_ENCRYPTION_KEY=development-only-profile-encryption-key
PROFILE_ENCRYPTION_KEY_VERSION=development-v1
OPS_ENABLED=false
ACCOUNT_DELETION_GRACE_DAYS=7

# AI 文本生成。客户端不得保存或读取此密钥。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
AI_GENERATION_TIMEOUT_SECONDS=30
AI_GENERATION_LIMIT=20
AI_GENERATION_WINDOW_SECONDS=600
# 紧急停止新的 Skill 处方生成与计划激活；默认关闭，本地规则计划不受影响。
TRAINING_PLAN_KILL_SWITCH=false
KNOWLEDGE_CATALOG_ENABLED=true
PROFILE_PROPOSAL_ENABLED=true
TRAINING_PRESCRIPTION_V2_ENABLED=true
TRAINING_STRUCTURE_V1_ENABLED=false
PLAN_REVISION_ENABLED=true
PAID_PLAN_GENERATION_GATE_ENABLED=false

# 苹果自动续费订阅。根证书为服务端本地 PEM/DER 文件路径，多个路径用逗号分隔。
IOS_SUBSCRIPTION_ENABLED=false
APPLE_SUBSCRIPTION_PRODUCT_ID=com.zhilian.trainmate.membership.monthly
APPLE_BUNDLE_ID=com.zhilian.trainmate
APPLE_SUBSCRIPTION_ENVIRONMENT=sandbox
APPLE_APP_ID=
APPLE_ROOT_CERTIFICATES=

# Phase 1 账号服务。开发环境默认使用不实际发送的固定验证码模式；生产环境
# 必须替换所有 development-only 密钥，并通过部署平台的密钥管理功能注入。
JWT_SIGNING_KEY=development-only-replace-before-production
PHONE_HASH_KEY=development-only-replace-before-production
EMAIL_HASH_KEY=development-only-replace-before-production
SMS_CODE_SIGNING_KEY=development-only-replace-before-production
EMAIL_CODE_SIGNING_KEY=development-only-replace-before-production
REFRESH_TOKEN_SIGNING_KEY=development-only-replace-before-production
SMS_PROVIDER=development
DEVELOPMENT_SMS_CODE=246810
EMAIL_PROVIDER=development
DEVELOPMENT_EMAIL_CODE=246810
TERMS_VERSION=internal-test-2026-07-13.1
PRIVACY_VERSION=internal-test-2026-07-13.1
SMS_CODE_TTL_SECONDS=300
SMS_CODE_MAX_ATTEMPTS=5
SMS_CHALLENGE_LIMIT_PER_WINDOW=3
SMS_CHALLENGE_WINDOW_SECONDS=600
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CHALLENGE_LIMIT_PER_WINDOW=3
EMAIL_CHALLENGE_WINDOW_SECONDS=600
SESSION_REFRESH_TTL_DAYS=30

# SMS_PROVIDER=tencent 时必填。短信模板必须依次接收验证码和有效分钟数。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# EMAIL_PROVIDER=smtp 时必填。生产环境仅允许 starttls 或 ssl 加密连接。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10

# 赛事图片识别。真实密钥只写入被忽略的 backend/.env。
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=
MINIMAX_TIMEOUT_SECONDS=30
RACE_IMAGE_MAX_BYTES=10485760
RACE_RECOGNITION_LIMIT=10
RACE_RECOGNITION_WINDOW_SECONDS=600

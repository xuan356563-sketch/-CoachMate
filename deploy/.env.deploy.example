# 该文件只保存非密钥部署元数据。复制为 .env.deploy 后再填写。
TRAINMATE_API_IMAGE=REPLACE_WITH_TCR/trainmate-api:REPLACE_WITH_GIT_SHA
TRAINMATE_OPS_WEB_IMAGE=REPLACE_WITH_TCR/trainmate-ops-web:REPLACE_WITH_GIT_SHA
TRAINMATE_ENV_FILE=/opt/trainmate/secrets/production.env
API_DOMAIN=api.example.com
APP_VERSION=REPLACE_WITH_RELEASE_VERSION

# 上线前必须在腾讯云控制台创建数据库备份或恢复点，并记录非敏感回执编号。
BACKUP_RECEIPT_ID=REPLACE_WITH_BACKUP_RECEIPT
DEPLOY_STATE_DIR=/opt/trainmate/state
ALLOW_RISKY_FLAGS=false

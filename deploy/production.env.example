# 此文件仅列出生产变量名和安全默认开关，不得填写或提交真实密钥。
APP_NAME=TrainMate API
APP_ENV=production
APP_VERSION=REPLACE_WITH_RELEASE_VERSION
DATABASE_URL=REPLACE_WITH_POSTGRESQL_URL
REDIS_URL=REPLACE_WITH_REDIS_URL
CORS_ORIGINS=https://app.example.com

# 第一批上线保持高风险能力关闭，完成对应验收后再单独放量。
SYNC_ENABLED=false
HEALTH_PROFILE_CLOUD_ENABLED=false
OPS_ENABLED=true
TRAINING_PLAN_KILL_SWITCH=false
KNOWLEDGE_CATALOG_ENABLED=true
PROFILE_PROPOSAL_ENABLED=false
TRAINING_PRESCRIPTION_V2_ENABLED=true
TRAINING_STRUCTURE_V1_ENABLED=false
PLAN_REVISION_ENABLED=false
IOS_SUBSCRIPTION_ENABLED=false
PAID_PLAN_GENERATION_GATE_ENABLED=false

PROFILE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
PROFILE_ENCRYPTION_KEY_VERSION=production-v1
HEALTH_PROFILE_CONSENT_VERSION=REPLACE_WITH_PUBLISHED_CONSENT_VERSION

JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
PHONE_HASH_KEY=REPLACE_WITH_RANDOM_SECRET
EMAIL_HASH_KEY=REPLACE_WITH_RANDOM_SECRET
SMS_CODE_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
EMAIL_CODE_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
REFRESH_TOKEN_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET

SMS_PROVIDER=tencent
EMAIL_PROVIDER=smtp
TERMS_VERSION=REPLACE_WITH_PUBLISHED_TERMS_VERSION
PRIVACY_VERSION=REPLACE_WITH_PUBLISHED_PRIVACY_VERSION

TENCENT_SECRET_ID=REPLACE_WITH_SECRET_MANAGER_VALUE
TENCENT_SECRET_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
TENCENT_SMS_SDK_APP_ID=REPLACE_WITH_VALUE
TENCENT_SMS_SIGN_NAME=REPLACE_WITH_VALUE
TENCENT_SMS_TEMPLATE_ID=REPLACE_WITH_VALUE
TENCENT_SMS_REGION=ap-guangzhou

SMTP_HOST=REPLACE_WITH_VALUE
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_VALUE
SMTP_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
SMTP_FROM_EMAIL=REPLACE_WITH_VALUE
SMTP_SECURITY=starttls

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE

APPLE_SUBSCRIPTION_PRODUCT_ID=com.zhilian.trainmate.membership.monthly
APPLE_BUNDLE_ID=com.zhilian.trainmate
APPLE_SUBSCRIPTION_ENVIRONMENT=production
APPLE_APP_ID=
APPLE_ROOT_CERTIFICATES=
